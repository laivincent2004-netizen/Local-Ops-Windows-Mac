#!/bin/bash
set -u
umask 077

PROJECT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

show_error() {
  /usr/bin/osascript -e 'on run argv' \
    -e 'display alert "总控台" message (item 1 of argv) as critical' \
    -e 'end run' "$1" >/dev/null 2>&1 || true
}

if [ ! -f "$PROJECT_DIR/server.py" ]; then
  show_error "启动文件不完整。请保留“总控台.app”和 server.py、static 文件夹在同一个发行目录中。"
  exit 2
fi
cd "$PROJECT_DIR" || {
  show_error "无法进入总控台所在目录。"
  exit 1
}
PYTHON_BIN="$(command -v python3)"
if [ -z "$PYTHON_BIN" ]; then
  show_error "未找到 Python 3。请安装 Python 3.12 或更高版本后重试。"
  exit 127
fi
if ! "$PYTHON_BIN" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)'; then
  show_error "Python 版本过低。总控台需要 Python 3.12 或更高版本。"
  exit 126
fi

exec "$PYTHON_BIN" "$PROJECT_DIR/server.py" --launcher
